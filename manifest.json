{
	"name": "Hyper Password",
	"short_name": "Password",
	"description": "Unique strong password generator. PBKDF2 x10K, no storage, works offline.",
	"version": "1.0.0",
	"manifest_version": 3,
	"icons": {
		"128": "hyoo/password/logo/logo.png"
	},
	"action": {
		"default_popup": "index.html",
		"default_icon": "hyoo/password/logo/logo.png",
		"default_title": "Hyper Password"
	},
	"permissions": ["activeTab", "clipboardWrite"],
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+P",
				"mac": "Command+Shift+P"
			},
			"description": "Generate password"
		}
	}
}
